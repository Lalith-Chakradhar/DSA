import java.util.*; 
class Solution
{
	//Idea - The player should go to cells such that the distance for him is near compared to monster’s distance to that cell.
	//Algorithm
	//1. Find shortest distance for each unblocked cell for the monsters.
	//2. Find shortest distance for each unblocked cell for the player.
	//3. Now traverse with starting point and follow the path where player distance is minimum and monster distance is maximum.
	//4. If ever in that path you encounter monster, then try alternate paths if possible. If possible then while visiting itself draw the trace otherwise print -1.
	
	 static int[] dr = {-1, 0, 1, 0};
    	   static int[] dc = {0, 1, 0, -1};

           static char[] directions = {'U', 'R', 'D', 'L'};

    	   static int[][] monster;
    	   static int[][] player;

    	   static char[][] parent;
   	   static boolean[][] visited;

    	   static int n, m;
	
	 static void monsterBFS(char[][] grid)
	{
		Queue<int[]>  q = new LinkedList<>();
		Queue<int[]> level = new LinkedList<>();
		
		for(int i=0; i<n; i++)
		{
			for(int j=0; j<n; j++)
			{
				monster[i][j] = -1;
				if(grid[i][j] ==‘M’)
				{
					q.offer(new int[]{i,j});
					monster[i][j] = 0;
				}
			}
		}
		
		
		while(!q.isEmpty())
		{
			int[] node = q.poll();
			
			int r = node[0];
			int c = node[1];
		
			monster[r][c] = count;
			
			for(int i=0; i<dr.length; i++)
			{
				int dx = r + dr[i];
				int dy = c + dc[i]; 

				if(dx>=0 && dx<n && dy>=0 && dy<m && grid[dx][dy] != “#” && monster[dx][dy] ==-1)
				{
					monster[dx][dy] = monster[r][c] + 1;
					q.offer(new int[]{dx, dy});
				}
			}
		}
	}
	
	 // BFS for player
    	   static void playerBFS(char[][] grid, int sr, int sc)
	{

		Queue<Integer> q = new LinkedList<>();
		
		int[][] visited = new int[n][m];
		player = new int[n][m];

        	     parent = new char[n][m];
		     
		     q.offer(new int[]{sr, sc});
		     
		      visited[sr][sc] = true;
        	      player[sr][sc] = 0;
		     
        	       // Player already starts at boundary
       		      if (sr == 0 || sr == n - 1 ||
               sc == 0 || sc == m - 1) {
            		System.out.println("YES");
            		System.out.println(0);
            		System.out.println();
            		return;
       		      }

		
		while(!q.isEmpty())
		{
			int[] node = q.poll();
			
			int r = node[0];
			int c = node[1];
			
			for(int i=0; i<dr.length; i++)
			{
				int dx = r + dr[i];
				int dy = c + dc[i]; 
				
				if(dx>=0 && dx<n && dy>=0 && dy<m && grid[dx][dy] != “#” && visited[dx][dy])
				{
					 int nextTime = player[r][c] + 1;
					
					// Player must reach before every monster, so time should always be less
                				   if (nextTime >= monster[dx][dy]) {
                    					continue;
                				   }

						   visited[dx][dy] = true;
				
						   player[dx][dy] = nextTime;

					// Store direction used to reach this cell
                				   parent[dx][dy] = directions[i];

						   //Found an escape
						   if(isBoundary(dx, dy)) {

							StringBuilder path = new StringBuilder();
							
							 int cr = dx;
                    					 int cc = dy;
						
							//back tracing path in reverse
							while (cr != sr || cc != sc) {

                       						char dir = parent[cr][cc];

                        					path.append(dir);

                        					if (dir == 'U') cr++;
                        					else if (dir == 'D') cr--;
                        					else if (dir == 'L') cc++;
                        					else if (dir == 'R') cc--;
                    					}
							
							path.reverse();
							
							System.out.println("YES");
                    					System.out.println(path.length());
                    					System.out.println(path);

                    					return;
						   }
						q.offer(new int[]{dx, dy});    
				}		
			}
			
		}
		
		System.out.println("NO");
	}

	public static void main(String arg[])
	{
		Scanner sc = new Scanner(System.in);

		int n = sc.nextInt();
		int m = sc.nextInt();
		
		char[][] grid = new char[n][m];
		
		     int sr = -1, sc2 = -1;
		
		for(int i=0; i<n; i++)
		{
			String s = sc.next();
	
			for(int j=0; j<m; j++)
			{
				grid[i][j] = s.charAt(j);

				if(grid[i][j] == ‘A’){
					sr = i;
					sc2=j;
				}
			}
		}
		
		monster = new int[n][m];

        	     monsterBFS(grid);

                     playerBFS(grid, sr, sc2);
	}
}
