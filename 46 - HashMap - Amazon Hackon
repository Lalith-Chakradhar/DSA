class Ideone
{
	//Algorithm
	//1. Instead of concatinating numbers, you can find each numbers digits count and =>
	// Eg: 10, 5 -> 105 => 10 * 10^1 + 5.
	//2. Use the formula to find out the numbers and sum the numbers.
	
	public static int findDigits(int num)
	{
		int count = 0;
		
		if(num==0) return 1;
		
		while(num != 0)
		{
			count++;
			num = num / 10;
		}
		
		return count;
	}
	
	public static long findPow(int digits)
	{
		long mp = 1;
		
		while(digits>0)
		{
			mp *= 10;
			digits--;
		}
		
		return mp;
	}
	
	public static int findPairSum(int[] arr)
	{
		int n = arr.length;
		int[] digits = new int[n];
		
		for(int i=0; i<n; i++)
		{
			digits[i] = findDigits(arr[i]);
		}
		
		long sum = 0L;
		
		for(int i=0; i<n; i++)
		{
			for(int j=i+1; j<n; j++)
			{
				sum += (arr[i]*findPow(digits[j]) + arr[j])%998244353;
			}
		}
		
		return (int) sum%998244353;
	}
	
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		
		int[] arr = new int[n];
		
		for(int i=0; i<n; i++)
		{
			arr[i] = sc.nextInt();
		}
		
		System.out.println("Max sum of all the concatenated pairs= "+findPairSum(arr));
	}
}
