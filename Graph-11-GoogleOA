import java.util.*;
import java.lang.*;
import java.io.*;

/* Name of the class has to be "Main" only if the class is public. */
class Ideone
{
  
	//Idea -
	// We can convert each and every character of string to next character such that we reach next subset of chars where subset of target string match. 
	//We will continue doing this process till we reach target string. So instead of iterating each letter and converting
	// leading n*26 solutions (converting all chars for each letter such that it reach least maximum char).
	//We can map which char should be converted to what using a graph and then take sum of size of components-1.

  //Make the diagram as well.
	
	//Algorithm
	//1.Convert each character such that DSU can be made.
	//2. If parent of both letters are not same then makde parent of character of String a to b. Increment ops.
  //3. Return ops count.
	
	static int[] parent = new int[26];
	
	static int find(int x)
	{
		return parent[x] == x ? x : (parent[x] = find(parent[x]));
	}
	
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		String A = sc.nextLine();
		String B = sc.nextLine();
		
		for(int i=0; i<26; i++) parent[i] = i;
		
		int ops = 0;
		
		for(int i=0; i<A.length(); i++)
		{
			int a = A.charAt(i) - 'a';
			int b = B.charAt(i) - 'a';
			
			if(a>b) 
			{
				System.out.println(-1);
				return;
			}
			
			if(find(a) == find(b)) continue;
			
			//find(a) != find(b) different parents
			parent[a] = b;
			ops++;
		}
		
		return ops;
	}
}

