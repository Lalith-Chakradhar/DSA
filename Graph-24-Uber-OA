import java.util.*;
import java.lang.*;
import java.io.*;

/* Name of the class has to be "Main" only if the class is public. */
class Ideone
{
	//Algorithm
	//1. Find shortest path using bfs traversal from source to destination.
	//2. At each node, store the max blue balls count in the path.
	//3. At destination you will get max blue balls count.
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		
		int V = sc.nextInt();
		int E = sc.nextInt();
		
		List<Integer> adjList[] = new ArrayList[V+1];
		
		for(int i=1 ;i<=V; i++)
		{
			adjList[i] = new ArrayList<>();
		}
		
		for(int i=0; i<E; i++)
		{
			int a = sc.nextInt();
			int b = sc.nextInt();
			
			adjList[a].add(b);
			adjList[b].add(a);
		}
		
		char[] balls = new char[V+1];
		
		for(int i=1; i<=V; i++)
		{
			balls[i] = sc.next();
		}
		
		int source = sc.nextInt();
		
		int[] visited = new int[V+1];
		int[] maxBlue = new int[V+1];
		
		Queue<Integer> q = new LinkedList<>();
		
		q.add(source);
		visited[source] = 1;
		
		if(balls[source] == 'B')
		{
			maxBlue[source] = 1;
		}
		
		while(!q.isEmpty())
		{
			int node = q.poll();
			
			for(int child: adjList[node])
			{
				if(visited[child] == 0)
				{
					q.offer(child);
					visited[child] = 1;
					
				}
				
				if(balls[child] == 'B')
				{
					maxBlue[child] = Math.max(maxBlue[child],maxBlue[node] + 1);
				}
				else
				{
					maxBlue[child] = Math.max(maxBlue[child],maxBlue[node]);
				}
			}
		}
	}
}
