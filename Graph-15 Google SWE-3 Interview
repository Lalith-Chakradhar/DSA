import java.util.*;
import java.lang.*;
import java.io.*;

/* Name of the class has to be "Main" only if the class is public. */
class Ideone
{
	//Idea - Can we precompute power such that we can convert as weighted edges - +power - weight
	//Algorithm
	//1. Traverse the graph using dfs topo sort. In the process, find out the weights + power.
	//2. Now pop out topo sorted edges from stack such that we can find longest path. In this process 
	//find out paths which has max energy. You have to do expansion but not relaxation.
	//3. You get the path where max energy is there which tells minimum extra energy is required.
	
	static void dfsTopoSort(ArrayList<Integer<>>[] adjList, Stack<Integer> stk, int[] visited,int[] power, int source)
	{
		visited[source] = 1;
		
		for(ArrayList<Integer> child: adjList[source])
		{
			if(visited[child.get(0)] == 0)
			{
				dfsTopoSort(adjList, stk, visited, child.get(0));
			}
		}
		
		stk.push(source);
	}
	
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int m = sc.nextInt();
		
		ArrayList<Integer<>>[] adjList = new ArrayList[n];
		for(int i=0; i<m; i++)
		{
			int x = sc.nextInt();
			int y = sc.nextInt();
			int edgeWeight = sc.nextInt();
			
			adjList[x].add(new ArrayList<>{y, edgeWeight});
		}
		
		int[] power = new int[n];
		for(int i=0; i<n; i++)
		{
			power[i] = sc.nextInt();	
		}
		
		Stack<Integer> stk = new Stack<>();
		int[] visited = new int[n];
		
		for(int i=0; i<n; i++)
		{
			if(visited[i] == 0)
			{
				dfsTopoSort(adjList, stk, visited, power, 0);
			}
		}
		
		
		
	}
}
