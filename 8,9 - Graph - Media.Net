/* package whatever; // don't place package name! */

import java.util.*;
import java.lang.*;
import java.io.*;

/* Name of the class has to be "Main" only if the class is public. */
class Ideone
{
	//Algorithm
	//1. Perform dfs of all unblocked nodes in 2d matrix. Find each node component number and store in array.
	//2. Find sed value by checking whether the value is multiple of current node, it is from other component and it should have some compNum array value.  
	//3. Return the sed value;
	
	static void dfs(int[][] grid, row, col, rowdelta, coldelta, compCount, compNum)
	{
		compNum[grid[i][j]] = compCount;
		
		int r = grid.length;
		int c = grid[0].length;
		
		for(int i = 0; i<rowdelta.length; i++)
		{
			int nr = row + rowdelta[i];
			int nc = col + coldelta[j];
			
			if(nr>=0 && nr<r && nc>=0 && nc<c && grid[nr][nc] != -1 && compNum[grid[nr][nc]]==0)
			{
				dfs(grid,nr,nc,rowdelta,coldelta,compCount,compNum);
			}
		}
		
	}
	
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		int rows = sc.nextInt();
		int columns = sc.nextInt();
		
		int[][] grid = new int[rows][columns];
		int maxVal = Integer.MIN_VALUE;
		for(int i=0; i<rows; i++)
		{
			for(int j=0; j<columns; j++)
			{
				grid[i][j] = sc.nextInt();
			}
			
			maxVal = Math.max(maxVal, grid[i][j]);
		}
		
		int[] compNum = new int[maxVal+1];
		int[] rowdelta = {-1, 1, 0, 0};
		int[] coldelta = {0,0, -1, 1};
		int compCount = 0;
		
		for(int i=0; i<rows; i++)
		{
			for(int j=0; j<columns; j++)
			{
				if(grid[i][j] != -1 && compNum[grid[i][j]] == 0 ) // not visited yet
				{
					compCount++;
					dfs(grid,i,j,rowdelta,coldelta,compCount, compNum);
				}
				
			}
		}
		
		int totalSed = 0;
		
		for(int k=1; k<=compCount; k++)
		{
			for(int i=0; i<rows; i++)
			{
				for(int j=0; j<columns; j++)
				{
					if(grid[i][j] != -1)
					{
						int curr = grid[i][j];
						
						for(int l=curr; l<=maxVal; l+=curr)
						{
							if(compNum[l] != 0 && compNum[l] !=k)
							{
								totalSed += l;
							}
						}
					}
				}
			}
		}
		
		return totalSed % 10000000;
	}
}
