/* package whatever; // don't place package name! */

import java.util.*;
import java.lang.*;
import java.io.*;

/* Name of the class has to be "Main" only if the class is public. */
class Ideone
{
	//Algorithm
	//1. Perform dfs of all unblocked nodes in 2d matrix. Find each node component number.
	//2. Now find sed value for all the cells. Find frequency of all nodes in hashmap.
	//3. Inorder to find sed value, for current component cells, remove these cells from hashmap and
	//find factors and check for other component cells. If present, add the freq*val into total sed value.
	//4. Now add back frequency of current component.
	
	static void dfs(int[][] grid, row, col, rowdelta, coldelta, compCount, compNumGrid)
	{
		compNumGrid[row][col] = compCount;
		
		int r = grid.length;
		int c = grid[0].length;
		
		for(int i = 0; i<rowdelta.length; i++)
		{
			for(int j = 0; j<coldelta.length; j++)
			{
				if(rowdelta[i]!=0 && coldelta[j]!=0) // no diagonal iteration in the problem allowed
				{
					continue;
				}
				
				int nr = row + rowdelta[i];
				int nc = col + coldelta[j];
				
				if(nr>=0 && nr<r && nc>=0 && nc<c && grid[i][j] != -1 && compNumGrid[nr][nc]==0)
				{
					dfs(grid,nr,nc,rowdelta,coldelta,compCount,compNumGrid);
				}
			}
		}
		
	}
	
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		int rows = sc.nextInt();
		int columns = sc.nextInt();
		
		int[][] grid = new int[rows][columns];
		
		HashMap<Integer,Integer> hm = new HashMap<>();
		for(int i=0; i<rows; i++)
		{
			for(int j=0; j<columns; j++)
			{
				grid[i][j] = sc.nextInt();
				
				if(grid[i][j] != -1)
				{
					hm.put(grid[i][j], hm.getOrDefault(grid[i][j],0)+1);
				}
			}
		}
		
		int[][] compNumGrid = new int[rows][columns];
		int[] rowdelta = {-1, 1, 0, 0};
		int[] coldelta = {0,0, -1, 1};
		int compCount = 0;
		
		for(int i=0; i<rows; i++)
		{
			for(int j=0; j<columns; j++)
			{
				if(grid[i][j] != -1 && compNum[i][j] == 0 ) // not visited yet
				{
					compCount++;
					dfs(grid,i,j,rowdelta,coldelta,compCount, compNumGrid);
				}
				
			}
		}
		
		int totalSed = 0;
		
	}
}

