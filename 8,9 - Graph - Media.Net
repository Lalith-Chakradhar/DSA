import java.util.*;
import java.lang.*;
import java.io.*;

/* Name of the class has to be "Main" only if the class is public. */
class Ideone
{
	//Algorithm
	//1. Perform dfs of all unblocked nodes in 2d matrix. Find each node component number.
	//2. Now find sed value for all the cells. Find frequency of all nodes in hashmap.
	//3. Inorder to find sed value, for current component cells, remove these cells from hashmap and
	//find factors and check for other component cells. If present, add the freq*val into total sed value.
	//4. Now add back frequency of current component.
	
	static void dfs(int[][] grid, row, col, rowdelta, coldelta, compCount, componentNumberMap)
	{
		componentNumberMap.put(grid[row][col], componentNumberMap.get(grid[row][col]).add(compCount));
		
		int r = grid.length;
		int c = grid[0].length;
		
		for(int i = 0; i<rowdelta.length; i++)
		{
			int nr = row + rowdelta[i];
			int nc = col + coldelta[j];
			
			if(nr>=0 && nr<r && nc>=0 && nc<c && grid[i][j] != -1 && componentNumberMap.get(grid[nr][nc]).isEmpty())
			{
				dfs(grid,nr,nc,rowdelta,coldelta,compCount,componentNumberMap);
			}
		}
		
	}
	
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		int rows = sc.nextInt();
		int columns = sc.nextInt();
		
		int[][] grid = new int[rows][columns];
		
		//To store component number. size - ssum of what all components it is present will give
		//frequency of node value
		Map<Integer,Set<Integer>> componentNumberMap = new HashMap<Integer, HashSet<Integer>>();
		
		for(int i=0; i<rows; i++)
		{
			for(int j=0; j<columns; j++)
			{
				grid[i][j] = sc.nextInt();
			}
			
			if(grid[i][j] != -1)
			{
				componentNumberMap.put(grid[i][j], new HashSet<Integer>());
			}
			
		}
		
		int[] rowdelta = {-1, 1, 0, 0};
		int[] coldelta = {0,0, -1, 1};
		int compCount = 0;
		
		int r = grid.length;
		int c = grid[0].length;
		
		for(int i=0; i<rows; i++)
		{
			for(int j=0; j<columns; j++)
			{
				if(grid[i][j] != -1 && componentNumberMap.get(grid[i][j]) == null ) // not visited yet
				{
					compCount++;
					dfs(grid,i,j,rowdelta,coldelta,compCount, componentNumberMap);
				}
				
			}
		}
		
		int totalSed = 0;
		
		for(int i=1; i<=compCount; i++)
		{
			for(int j=0; j<r; j++)
			{
				for(int k=0; k<c; k++)
				{
					if(componentNumberMap.get(grid[j][k]).contains(i))
					{
						totalSed += (componentNumberMap.get(grid[j][k]).size()-1)*grid[j][k];
					}
					else
					{
						//find factors
						int num = 2*grid[i][j];
						for(int l=num; l<1000000; l+=num)
						{
							if()
						}
					}
				}
			}
		}
		
		
	}
}
