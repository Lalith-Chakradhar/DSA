import java.util.*;
import java.lang.*;
import java.io.*;

/* Name of the class has to be "Main" only if the class is public. */
class Ideone
{
	//Algorithm
	//1. Keep Graph G as reference for graph F. While taking input, 
	//additionally store the edge information in seperate arrays for F and G for later.
	//Now do dfs on graph G. 
	//2. Mark the component numbers of each node in graph G.
	//3. Now do dfs on graph F, check each node-node component. Take graph G component nodes as reference.
	//If component numbers are different, then break the edge (according to graph G they should be in same component). 
	//Increase the operations count.
	//4. After checking all the edges and breaking. Now according to graph G component numbers, 
	//do dfs again to find how many groups have common component number.
	//5. Merge the groups and add group size - 1 as number operations to total operations.
	
	public static void dfs(ArrayList<Integer>[] adjList, int compNum[], int num, int source)
	{
		compNum[source] = num;
		for(int child: adjList[source])
		{
			if(compNum[child] == 0)
			{
				dfs(adjList, compNum, num, child);
			}
		}
	}
	
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		int t = sc.nextInt();
		
		for(int i=0; i<t; i++)
		{
			int ops = 0;
			int n = sc.nextInt();
			
			if(n==1) return 0;
			
			int m1 = sc.nextInt(); // edges in F
			int m2 = sc.nextInt(); // edges in G
			
			List<int[]> f = new ArrayList<>();
			List<int[]> g = new ArrayList<>();
			
			ArrayList<Integer>[] FadjList = new ArrayList[n+1];
			ArrayList<Integer>[] GadjList = new ArrayList[n+1];
			
			for(int i=1; i<=n; i++)
			{
				FadjList[i] = new ArrayList<Integer>(); // connect once compIds are known
				GadjList[i] = new ArrayList<Integer>();
			}
			
			for(int k=1; k<=m1; k++)
			{
				int x = sc.nextInt();
				int y = sc.nextInt();
				
				f.add(new int[]{x,y});
			}
			
			for(int k=1; k<=m2; k++)
			{
				int x = sc.nextInt();
				int y = sc.nextInt();
				
				GadjList[x].add(y);
				GadjList[y].add(x);
				
				g.add(new int[]{x,y});
			}
			
			int[] GcompNum = new int[n+1];
			int compNum=0;
			
			for(int i=1; i<=n; i++)
			{
				if(GcompNum[i] == 0)
				{
					compNum++;
					dfs(GadjList, GcompNum, compNum, i);
				}
			}
			
			for(int[] edge: f)
			{
				int u = edge[0];
				int v = edge[1];
				
				if(GcompNum[u] == GcompNum[v])
				{
					FadjList[u].add(v);
					FadjList[v].add(u);
				}
				else
				{
					ops++;
				}
			}
			
			int[] FcompNum = new int[n+1];
			compNum=0;
			
			for(int i=1; i<=n; i++)
			{
				if(FcompNum[i] == 0)
				{
					compNum++;
					dfs(FadjList, FcompNum, compNum, i);
				}
			}
			
			// ------------------------------------
            // STEP 5:
            // Count F components inside each
            // G component
            // ------------------------------------
			Map<Integer, Set<Integer>> map = new HashMap<>();
			
			for(int i=1; i<=n; i++)
			{
				int gComp = GcompNum[i];
				int fComp = FcompNum[i];
				
				map.putIfAbsent(gComp, new HashSet<>());
				
				map.get(gComp).add(fComp);
			}
			
			// If a G component has k F components,
            // we need k - 1 additions.
            for(Set<Integer> set : map.values())
            {
                ops += set.size() - 1;
            }

            System.out.println(ops);
			
		}
	}
}
