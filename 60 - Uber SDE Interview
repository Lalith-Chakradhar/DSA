// If i,j,k are distinct
import java.util.*;

class Main {

    /*
     * Returns:
     *
     * max |arr[i] - arr[j] - arr[k]| + |i - j - k|
     *
     * assuming i, j, k must be distinct.
     */
    static long findMaxValue(int[] arr) {
        int n = arr.length;

        if (n < 3) {
            throw new IllegalArgumentException("Array must contain at least 3 elements");
        }

        // x[i] = arr[i] + i
        long[] x = new long[n];

        // y[i] = arr[i] - i
        long[] y = new long[n];

        for (int i = 0; i < n; i++) {
            x[i] = (long) arr[i] + i;
            y[i] = (long) arr[i] - i;
        }

        // Cases:
        //
        // 1. x[i] - x[j] - x[k]
        // 2. x[j] + x[k] - x[i]
        // 3. y[i] - y[j] - y[k]
        // 4. y[j] + y[k] - y[i]
        //
        // For each array, calculate both:
        // max(value[i] - value[j] - value[k])
        // and
        // max(value[j] + value[k] - value[i])

        long ans = Long.MIN_VALUE;

        ans = Math.max(ans, maxOneMinusTwo(x));
        ans = Math.max(ans, maxTwoMinusOne(x));

        ans = Math.max(ans, maxOneMinusTwo(y));
        ans = Math.max(ans, maxTwoMinusOne(y));

        return ans;
    }

    // max value[i] - value[j] - value[k]
    // where i, j, k are distinct.
    static long maxOneMinusTwo(long[] value) {

        // We need:
        // largest value[i]
        // minus two smallest values[j], values[k].
        //
        // Keep 3 smallest values so that we can always
        // find two indices different from i.

        long[][] smallest = getSmallestThree(value);
        long[][] largest = getLargestThree(value);

        long ans = Long.MIN_VALUE;

        // Try candidates from the largest three.
        for (long[] a : largest) {
            if (a[0] == Long.MIN_VALUE) continue;

            long iValue = a[0];
            int iIndex = (int) a[1];

            int count = 0;
            long firstMin = 0;
            long secondMin = 0;

            for (long[] b : smallest) {
                if (b[0] == Long.MAX_VALUE) continue;

                int index = (int) b[1];

                if (index == iIndex) continue;

                if (count == 0) {
                    firstMin = b[0];
                } else {
                    secondMin = b[0];
                }

                count++;

                if (count == 2) break;
            }

            if (count == 2) {
                ans = Math.max(ans, iValue - firstMin - secondMin);
            }
        }

        return ans;
    }

    // max value[j] + value[k] - value[i]
    // where i, j, k are distinct.
    static long maxTwoMinusOne(long[] value) {

        // We need:
        // two largest values[j], values[k]
        // minus the smallest value[i].

        long[][] largest = getLargestThree(value);
        long[][] smallest = getSmallestThree(value);

        long ans = Long.MIN_VALUE;

        for (long[] a : smallest) {
            if (a[0] == Long.MAX_VALUE) continue;

            long iValue = a[0];
            int iIndex = (int) a[1];

            int count = 0;
            long firstMax = 0;
            long secondMax = 0;

            for (long[] b : largest) {
                if (b[0] == Long.MIN_VALUE) continue;

                int index = (int) b[1];

                if (index == iIndex) continue;

                if (count == 0) {
                    firstMax = b[0];
                } else {
                    secondMax = b[0];
                }

                count++;

                if (count == 2) break;
            }

            if (count == 2) {
                ans = Math.max(ans, firstMax + secondMax - iValue);
            }
        }

        return ans;
    }

    // Returns 3 smallest values.
    // Each entry is {value, index}.
    static long[][] getSmallestThree(long[] value) {

        long[][] result = {
            {Long.MAX_VALUE, -1},
            {Long.MAX_VALUE, -1},
            {Long.MAX_VALUE, -1}
        };

        for (int i = 0; i < value.length; i++) {

            if (value[i] < result[0][0]) {
                result[2] = result[1];
                result[1] = result[0];
                result[0] = new long[]{value[i], i};

            } else if (value[i] < result[1][0]) {
                result[2] = result[1];
                result[1] = new long[]{value[i], i};

            } else if (value[i] < result[2][0]) {
                result[2] = new long[]{value[i], i};
            }
        }

        return result;
    }

    // Returns 3 largest values.
    // Each entry is {value, index}.
    static long[][] getLargestThree(long[] value) {

        long[][] result = {
            {Long.MIN_VALUE, -1},
            {Long.MIN_VALUE, -1},
            {Long.MIN_VALUE, -1}
        };

        for (int i = 0; i < value.length; i++) {

            if (value[i] > result[0][0]) {
                result[2] = result[1];
                result[1] = result[0];
                result[0] = new long[]{value[i], i};

            } else if (value[i] > result[1][0]) {
                result[2] = result[1];
                result[1] = new long[]{value[i], i};

            } else if (value[i] > result[2][0]) {
                result[2] = new long[]{value[i], i};
            }
        }

        return result;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        System.out.println(
            "Maximum value |a[i] - a[j] - a[k]| + |i-j-k|: "
            + findMaxValue(arr)
        );

        sc.close();
    }
}


//If i,j,k can be same - 
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        long[] a = new long[n];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextLong();
        }

        long maxP = Long.MIN_VALUE;
        long minP = Long.MAX_VALUE;

        long maxQ = Long.MIN_VALUE;
        long minQ = Long.MAX_VALUE;

        for (int i = 0; i < n; i++) {
            long P = a[i] + i;  // a[i] + i
            long Q = a[i] - i;  // a[i] - i

            maxP = Math.max(maxP, P);
            minP = Math.min(minP, P);

            maxQ = Math.max(maxQ, Q);
            minQ = Math.min(minQ, Q);
        }

        long ans1 = maxP - 2 * minP;
        long ans2 = 2 * maxP - minP;

        long ans3 = maxQ - 2 * minQ;
        long ans4 = 2 * maxQ - minQ;

        long result = Math.max(
            Math.max(ans1, ans2),
            Math.max(ans3, ans4)
        );

        System.out.println(result);

        sc.close();
    }
}

