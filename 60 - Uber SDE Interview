import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        long[] a = new long[n];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextLong();
        }

        long max1 = Long.MIN_VALUE, min1 = Long.MAX_VALUE; // a[i] + i
        long max2 = Long.MIN_VALUE; // i - a[i]
        long max3 = Long.MIN_VALUE; // a[i] - i
        long max4 = Long.MIN_VALUE; // a[i] - i
        long max5 = Long.MIN_VALUE; // i - a[i]

        for (int i = 0; i < n; i++) {
            long val1 = a[i] + i;
            long val2 = i - a[i];
            long val3 = a[i] - i;
            long val4 = a[i] - i;
            long val5 = i - a[i];

            max1 = Math.max(max1, val1);
            min1 = Math.min(min1, val1);
            max2 = Math.max(max2, val2);
            max3 = Math.max(max3, val3);
            max4 = Math.max(max4, val4);
            max5 = Math.max(max5, val5);
        }

        long ans1 = max1 - 2 * min1;
        long ans2 = max2 + 2 * max3;
        long ans3 = max4 + 2 * max5;
        long ans4 = 2 * max1 - min1;

        long result = Math.max(Math.max(ans1, ans2), Math.max(ans3, ans4));
        System.out.println(result);
    }
}

