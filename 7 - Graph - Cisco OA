import java.util.*;
import java.lang.*;
import java.io.*;

/* Name of the class has to be "Main" only if the class is public. */
//Algorithm
//1. Do dfs and mark the component number for each node which are in multi-component graph setup.
//2. Now, iterate the queries and for -
//i. query = 2 : mark the node inactive (maintain an array), find the node in compNum array, 
//then use that num in 2D component set and remove the element.
//ii. query = 1 : check for marked node. If active return it else find the node in compNum array, 
//then use that num in 2D component set and get top element. 
class Ideone
{
	static void dfs(ArrayList<Integer> adjList, int[] used, int source, int[] compNum, int c)
	{
		used[source] = 1;
		compNum[source] = c;
		for(int child: adjList[source])
		{
			if(used[child]==0)
			{
				dfs(adjList, used, child, compNum, c);
			}
		}
	}
	
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		int pods = sc.nextInt();
		int n = sc.nextInt();
		
		ArrayList<Integer>[] adjList = new ArrayList[pods+1];
		
		for(int i=1; i<pods+1; i++)
		{
			adjList[i] = new ArrayList<Integer>();
		}
		
		for(int i=0; i<n; i++)
		{
			int x = sc.nextInt();
			int y = sc.nextInt();
			
			adjList[x].add(y);
			adjList[y].add(x);
		}
		
		int[] used = new int[pods+1];
		int[] compNum = new int[pods+1];
		int c = 0;
		
		for(int i=1; i<pods+1; i++)
		{
			if(used[i] == 0)
			{
				c++;
				dfs(adjList, used, i,compNum, c);
			}
		}
		
		Set<Integer>[] sortedAdjList = new TreeSet[c+1];
		//Component number 
		for(int i=1; i<=c; i++)
		{
			sortedAdjList[i] = new TreeSet<Integer>();
		}
		
		for(int i=1; i<compNum.length; i++)
		{
			sortedAdjList[compNum[i]].add(i);
		}
		
		int q = sc.nextInt();
		int[][] queries = new int[q][2];
		int[] mark = new int[n+1];
		
		
		
		for(int i=0; i<q; i++)
		{
			queries[i][0] = sc.nextInt();
			queries[i][1] = sc.nextInt();
			
			if(queries[i][0] == 2)
			{
				//make node inactive
				int node = queries[i][1];
				mark[node] = 1;
				
				//find in p and then remove it
				int comp = compNum[node];
				sortedAdjList[comp].remove(node);
			}
			else if(queries[i][0] == 1)
			{
				if(mark[queries[i][1]] == 0)
				{
					System.out.print(queries[i][1]+" ");
				}
				else
				{
					//find first in p and then get the top element
					int comp = compNum[queries[i][1]];
					System.out.println(sortedAdjList[comp].get()
				}
			}
		}
	}
}
